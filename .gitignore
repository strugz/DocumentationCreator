# Project sources fed in for documentation (keep out of version control)
projects/*
!projects/README.md

# Loose files at the top of output/ (only mode folders and README are tracked)
/output/*
!/output/README.md
!/output/mode-a/
!/output/mode-b/
!/output/mode-c/

# Generated exports
output/*/*/export/

# Python
__pycache__/
*.pyc

# Eval run outputs (the baseline in evals/baseline.json is tracked)
evals/runs/

# Node dependencies for tools/
tools/node_modules/

# Generated documents for individual projects (keep the empty mode folders)
/output/mode-a/*
!/output/mode-a/.gitkeep
/output/mode-b/*
!/output/mode-b/.gitkeep
/output/mode-c/*
!/output/mode-c/.gitkeep
