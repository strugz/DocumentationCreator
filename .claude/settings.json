{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/lint_on_write.py\"",
            "timeout": 30,
            "statusMessage": "Linting document"
          }
        ]
      }
    ]
  }
}
